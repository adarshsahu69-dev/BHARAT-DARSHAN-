# =============================================================================
# Bharat Darshan — environment variables
# =============================================================================
# Copy to `.env.local` for development. In CI these come from the repository or
# environment secrets; see the Deploying section of README.md.
#
# EVERYTHING HERE IS OPTIONAL. With no variables set the application runs in
# demo mode: it browses, searches, maps and routes normally, and accounts and
# trips live in the visitor's own browser. The banner at the top of every page
# says so.
# =============================================================================

# --- Site URL ---------------------------------------------------------------
# The canonical origin. Used for canonical tags, Open Graph URLs, the sitemap
# and OAuth redirect allow-listing. Must be https:// in production.
#
# The site is a static export served from GitHub Pages, so this has to include the
# repository path, e.g. https://<user>.github.io/bharat-darshan. It is the URL
# Google sign-in and email confirmation links return to, so add the matching
# <origin>/auth/callback to the Supabase redirect allow-list.
NEXT_PUBLIC_SITE_URL="https://github.com/adarshsahu69-dev/BHARAT-DARSHAN-.git"


# --- Supabase (auth + database) ----------------------------------------------
# When both of these are set, the app switches from demo mode to real
# authentication backed by Postgres with Row Level Security.
#
# The anon key is designed to be public: it is a client identifier, and every
# table's RLS policies are what actually protect the data. The service role key
# below is the opposite — it bypasses RLS and must never reach the browser.
#
# Find both under Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://nkjxiictzuxmczosykcp.supabase.co"

NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ranhpaWN0enV4bWN6b3N5a2NwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTExOTg3NTEsImV4cCI6MjEwNjc3NDc1MX0._jFJKLC6iYYp8SmmoMO6pfKUiJX8U8cOnJ_NqaXzwQk"

# Server-only. Used for admin operations that must bypass RLS.
# NEVER prefix this with NEXT_PUBLIC_, and never import it from a client
# component.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ranhpaWN0enV4bWN6b3N5a2NwIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTE5ODc1MSwiZXhwIjoyMTA2Nzc0NzUxfQ.ikZ7aYiUOexL-c8sn1Xt4iceTmUABDiAQSth4nfvFMw"


# --- Google Maps ------------------------------------------------------------
# You do not need a key for directions, routes or navigation. Those use
# Google's documented URL schemes, which work with no key and no billing
# account, and they are the parts a traveller actually needs.
#
# A key is only required if you want the richer embeds below.
#
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is shipped to the browser, so it MUST be
# restricted by HTTP referrer to your own domains. It is a client credential.
# GOOGLE_MAPS_SERVER_KEY is server-only and may carry broader privileges.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""


# --- Admin bootstrap --------------------------------------------------------
# Optional. The seed SQL does not promote anyone automatically; see the comment
# at the foot of supabase/migrations/0001_init.sql for the one-line statement to
# run by hand. This variable is only read as a convenience by the demo seeder.
BOOTSTRAP_ADMIN_EMAIL="adharshsahu69@gmail.com"
